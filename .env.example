# -----------------------------------------------------------------------------
# EDGEOS runtime mode
# -----------------------------------------------------------------------------
# demo: deterministic, explicitly labelled fixtures; no claim of live pricing.
# live: provider adapters run only when their required credentials are present.
EDGEOS_MODE=demo
EDGEOS_ENV=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_MODE=demo
# Browser calls stay same-origin and pass through the bounded Next.js BFF.
NEXT_PUBLIC_API_URL=/api/edgeos
# Server-only origin used by the Next.js same-origin BFF.
EDGEOS_INTERNAL_API_ORIGIN=http://localhost:8000
# Optional comma-separated override; otherwise WEB_ORIGIN is the only API CORS origin.
EDGEOS_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Auth + Postgres
# Use a publishable key in the browser. Never expose a secret/service-role key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Server-side durable repositories use psycopg. Use a PostgreSQL DSN; never put
# it in a NEXT_PUBLIC_* variable. Hosted live deployments default to TLS
# (`DATABASE_SSLMODE=require`); local Docker can use `prefer`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edgeos
DATABASE_SSLMODE=prefer
# Base64url-encoded 32-byte AES-GCM master key for provider credentials. Keep it
# in the deployment secret manager, outside PostgreSQL. When unset, credential
# saving is disabled while public credential-free adapters can still operate.
EDGEOS_CREDENTIAL_MASTER_KEY=
EDGEOS_CREDENTIAL_KEY_VERSION=v1
# Comma-separated Supabase user UUIDs allowed to record global match decisions.
EDGEOS_REVIEWER_USER_IDS=

# -----------------------------------------------------------------------------
# Read-only provider integrations
# -----------------------------------------------------------------------------
THE_ODDS_API_KEY=
# Comma-separated official sport keys, for example basketball_nba,americanfootball_nfl.
# Leaving this empty prevents worker quota consumption.
THE_ODDS_API_SPORTS=

# Polymarket international public REST market data uses the official Gamma/CLOB
# hosts compiled into the adapter and does not require a trading key.

# Polymarket US is a distinct product. Its implemented public REST market-data
# adapter needs no key. Institutional gRPC access is separate and not enabled.

# -----------------------------------------------------------------------------
# Ingestion / risk defaults
# -----------------------------------------------------------------------------
INGESTION_POLL_SECONDS=60
# Conservative estimated request budget; per-provider overrides use
# INGESTION_<PROVIDER_CODE>_REQUEST_BUDGET_PER_HOUR.
INGESTION_REQUEST_BUDGET_PER_HOUR=120
QUOTE_STALE_AFTER_SECONDS=90
# Paper capital used to size each research candidate, never a live order.
EDGEOS_PIPELINE_TOTAL_ALLOCATION=1000
EDGEOS_MAX_QUOTE_SKEW_SECONDS=5
EDGEOS_PIPELINE_MINIMUM_LIQUIDITY=1
# Explicit adverse-price assumption in basis points (10 bps = 0.10%).
EDGEOS_PIPELINE_SLIPPAGE_BPS=10
# Leave unknown measurements empty. These are not inferred or set to zero.
EDGEOS_MEASURED_PARTIAL_FILL_PROBABILITY=
EDGEOS_MEASURED_QUOTE_UPDATE_HZ=
EDGEOS_MEASURED_QUOTE_STABILITY=
EDGEOS_EXPECTED_LOCKUP_SECONDS=

