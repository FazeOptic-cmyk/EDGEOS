# Browser requests stay same-origin; the server-only proxy owns the real API origin.
NEXT_PUBLIC_API_URL=/api/edgeos
EDGEOS_INTERNAL_API_ORIGIN=http://127.0.0.1:8000
# Set dynamically by the desktop host; required only when EDGEOS_ENV=desktop.
EDGEOS_DESKTOP_WEB_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; required by account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_MODE=demo
# Set by the Windows packaging script; disables browser callback flows without a desktop deep link.
NEXT_PUBLIC_DESKTOP_BUILD=false
